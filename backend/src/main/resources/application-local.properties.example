# Copy to application-local.properties (same directory) and fill in real values.
# application-local.properties is gitignored and must never be committed.
#
# Loaded when the "local" Spring profile is active (default for laptop; see
# spring.profiles.default=local). In production set SPRING_PROFILES_ACTIVE=prod
# and inject secrets via environment variables instead.
#
# Prefer environment variables in production (see docs/SECURITY_SECRETS_MIGRATION.md).

# --- Database ---
# spring.datasource.url=jdbc:postgresql://localhost:5432/admindb
# spring.datasource.username=postgres
# If the password contains '$', prefer Unicode escape (e.g. Champu1\u0024) or env vars.
# spring.datasource.password=your-db-password

# --- OpenAI ---
# openai.api.key=sk-...
# openai.model=gpt-4o-mini

# --- SMTP (optional; also set kontexa.mail.enabled=true) ---
# kontexa.mail.enabled=true
# spring.mail.host=smtp.gmail.com
# spring.mail.port=587
# spring.mail.username=you@example.com
# spring.mail.password=your-app-password
